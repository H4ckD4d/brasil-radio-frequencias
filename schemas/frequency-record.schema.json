{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/H4ckD4d/brasil-radio-frequencias/blob/main/schemas/frequency-record.schema.json",
  "title": "RadioSync frequency record",
  "description": "Canonical CSV row schema. Empty strings are allowed only for optional CSV fields.",
  "type": "object",
  "additionalProperties": false,
  "x-schema-version": "1.0.0",
  "x-csv-columns": [
    "record_id", "country_code", "country_name", "state_code", "state_name", "state_id",
    "municipality_name", "municipality_slug", "municipality_id", "locality_name", "locality_id",
    "latitude", "longitude", "location_precision", "service", "station_name", "callsign",
    "channel_designator", "rx_frequency_mhz", "tx_frequency_mhz", "modulation", "digital_protocol",
    "ctcss_hz", "dcs_code", "dmr_color_code", "dmr_timeslot", "repeater_offset_mhz",
    "source_type", "source_claim", "source_name", "source_url", "source_publication_date",
    "source_accessed_date", "last_independently_verified_date", "verification_method",
    "verification_status", "operational_status", "redistribution_permission", "data_license",
    "attribution", "notes"
  ],
  "required": [
    "record_id", "country_code", "country_name", "state_code", "state_name", "state_id",
    "service", "rx_frequency_mhz", "modulation", "source_type", "source_name", "source_url", "source_accessed_date",
    "verification_status", "operational_status", "redistribution_permission"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$"},
    "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "country_name": {"type": "string", "minLength": 1},
    "state_code": {"type": "string", "pattern": "^[A-Z0-9-]{1,10}$"},
    "state_name": {"type": "string", "minLength": 1},
    "state_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$"},
    "municipality_name": {"type": "string"},
    "municipality_slug": {"type": "string", "pattern": "^$|^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "municipality_id": {"type": "string", "pattern": "^$|^[A-Za-z0-9._-]{1,32}$"},
    "locality_name": {"type": "string"},
    "locality_id": {"type": "string", "pattern": "^$|^[A-Za-z0-9._-]{1,32}$"},
    "latitude": {"type": "string"},
    "longitude": {"type": "string"},
    "location_precision": {"type": "string", "enum": ["", "exact", "approximate", "municipality", "state", "country"]},
    "service": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "station_name": {"type": "string"},
    "callsign": {"type": "string"},
    "channel_designator": {"type": "string"},
    "rx_frequency_mhz": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{4,6}$"},
    "tx_frequency_mhz": {"type": "string", "pattern": "^$|^[0-9]+\\.[0-9]{4,6}$"},
    "modulation": {"type": "string", "enum": ["AM", "FM", "NFM", "WFM", "SSB", "USB", "LSB", "CW", "digital", "other", "unknown"]},
    "digital_protocol": {"type": "string"},
    "ctcss_hz": {"type": "string", "pattern": "^$|^[0-9]{2,3}\\.[0-9]$"},
    "dcs_code": {"type": "string", "pattern": "^$|^[0-7]{3}[NI]?$"},
    "dmr_color_code": {"type": "string", "pattern": "^$|^(?:[0-9]|1[0-5])$"},
    "dmr_timeslot": {"type": "string", "enum": ["", "1", "2", "both", "unknown"]},
    "repeater_offset_mhz": {"type": "string", "pattern": "^$|^-?[0-9]+\\.[0-9]{4,6}$"},
    "source_type": {"type": "string", "enum": ["official_documentation", "operator_report", "community_submission", "secondary_compilation", "independent_reception", "unknown"]},
    "source_claim": {"type": "string"},
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "source_publication_date": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_accessed_date": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "last_independently_verified_date": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "verification_method": {"type": "string"},
    "verification_status": {"type": "string", "enum": ["official_documentation", "source_only", "independently_verified", "disputed", "unverified"]},
    "operational_status": {"type": "string", "enum": ["unknown", "reported_active", "reported_inactive", "verified_active", "verified_inactive", "not_applicable"]},
    "redistribution_permission": {"type": "string", "enum": ["allowed", "allowed_with_attribution", "restricted", "review_required"]},
    "data_license": {"type": "string"},
    "attribution": {"type": "string"},
    "notes": {"type": "string"}
  }
}

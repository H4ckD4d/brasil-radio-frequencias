{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/H4ckD4d/brasil-radio-frequencias/blob/main/schemas/municipality.schema.json",
  "title": "RadioSync Brazilian municipality record",
  "description": "Canonical schema for municipios.csv geographic reference rows.",
  "type": "object",
  "additionalProperties": false,
  "x-schema-version": "1.0.0",
  "x-csv-columns": ["codigo_ibge", "municipio", "uf", "pais"],
  "required": ["codigo_ibge", "municipio", "uf", "pais"],
  "properties": {
    "codigo_ibge": {
      "type": "string",
      "pattern": "^[0-9]{7}$"
    },
    "municipio": {
      "type": "string",
      "minLength": 1
    },
    "uf": {
      "type": "string",
      "enum": [
        "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO",
        "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI",
        "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO"
      ]
    },
    "pais": {
      "type": "string",
      "enum": ["BR"]
    }
  }
}
